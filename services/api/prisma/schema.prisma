generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TOURIST
  PROVIDER
  ADMIN
  OPERATIONS
  SUPPORT
  FINANCE
  QA
}

enum Language {
  EN
  UR
  ZH
}

enum ServiceType {
  HOTEL
  TRANSPORT
  GUIDE
  HIKING_GUIDE
  RESTAURANT
  PHOTOGRAPHY
  ACTIVITY
}

enum ProviderStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum BookingStatus {
  DRAFT
  REQUEST_SUBMITTED
  CALL_PENDING
  TOURIST_CONFIRMED
  PAYMENT_PENDING
  ADVANCE_PAID
  FULLY_PAID
  PROVIDER_SELECTION
  PROVIDER_PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  REFUNDED
  REQUIRES_ADMIN_ACTION
}

enum PaymentStatus {
  PENDING
  PROOF_SUBMITTED
  VERIFIED
  REJECTED
  REFUNDED
}

enum AssignmentStatus {
  PENDING_PROVIDER
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  FAILED
}

model User {
  id                String   @id @default(uuid())
  fullName          String
  email             String?  @unique
  phone             String?  @unique
  address           String?
  travelPreferences Json?
  passwordHash      String?
  role              UserRole
  preferredLanguage Language @default(EN)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  touristProfile    TouristProfile?
  providerProfile   Provider?
  bookings          Booking[] @relation("TouristBookings")
  assignments       BookingTeamAssignment[]
  assignedBy        BookingTeamAssignment[] @relation("AssignedBy")
  events            BookingEvent[]
  sessions          AuthSession[]
  consentRecords    ConsentRecord[]
  deletionRequests  DataDeletionRequest[]
  supportTickets    SupportTicket[]
  auditLogs         AuditLog[]
  customTripRequests CustomTripRequest[]
  providerRegistrations ProviderRegistration[]
  supportMessages   SupportMessage[]
  paymentSubmissions Payment[] @relation("PaymentSubmitter")
  paymentReviews    Payment[] @relation("PaymentReviewer")
  payoutApprovals   Payout[] @relation("PayoutApprover")
}

model TouristProfile {
  id String @id @default(uuid())
  userId String @unique
  country String?
  whatsapp String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Destination {
  id String @id @default(uuid())
  name String
  slug String @unique
  description String?
  shortDescription String?
  fullDescription String?
  bestFor String[]
  travelTime String?
  popularServices Json?
  imageUrl String?
  gallery Json?
  seoTitle String?
  seoDescription String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  packages Package[]
}

model Package {
  id String @id @default(uuid())
  destinationId String
  name String
  slug String @unique
  summary String?
  packageType String @default("Private")
  tier String @default("Standard")
  route String?
  durationDays Int
  basePrice Int
  currency String @default("PKR")
  imageUrl String?
  gallery Json?
  itinerary Json?
  cancellationSummary String?
  seoTitle String?
  seoDescription String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  destination Destination @relation(fields: [destinationId], references: [id])
  items PackageItem[]
  bookings Booking[]
}

model PackageItem {
  id String @id @default(uuid())
  packageId String
  serviceType ServiceType
  title String
  description String?
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
}

model Provider {
  id String @id @default(uuid())
  userId String? @unique
  businessName String
  ownerName String
  phone String
  serviceCategory ServiceType
  location String
  status ProviderStatus @default(PENDING_REVIEW)
  defaultCommissionRate Decimal? @db.Decimal(5, 2)
  media Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User? @relation(fields: [userId], references: [id])
  bookingItems BookingItem[]
  commissions Commission[]
  payouts Payout[]
}

model Booking {
  id                     String        @id @default(uuid())
  reference              String        @unique
  touristId              String
  packageId              String?
  destination            String
  travelStart            DateTime
  travelEnd              DateTime
  travelersCount         Int
  travelerType           String?
  tier                   String?
  pickupCity             String?
  specialRequests        String?
  whatsapp               String?
  country                String?
  preferredPaymentMethod String?
  status                 BookingStatus @default(CALL_PENDING)
  paymentStatus          PaymentStatus @default(PENDING)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  tourist                User          @relation("TouristBookings", fields: [touristId], references: [id])
  package                Package?      @relation(fields: [packageId], references: [id])
  items                  BookingItem[]
  teamAssignments        BookingTeamAssignment[]
  events                 BookingEvent[]
  payments               Payment[]
  commissions            Commission[]
}

model BookingItem {
  id String @id @default(uuid())
  bookingId String
  providerId String?
  serviceType ServiceType
  status AssignmentStatus @default(PENDING_PROVIDER)
  price Int?
  commission Int?
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider Provider? @relation(fields: [providerId], references: [id])
  commissions Commission[]
}

model BookingTeamAssignment {
  id String @id @default(uuid())
  bookingId String
  memberId String
  assignedById String?
  assignedAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  member User @relation(fields: [memberId], references: [id])
  assignedBy User? @relation("AssignedBy", fields: [assignedById], references: [id])
}

model BookingEvent {
  id String @id @default(uuid())
  bookingId String
  actorId String?
  eventType String
  payload Json?
  createdAt DateTime @default(now())
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id])
}

model AuthSession {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ConsentRecord {
  id           String   @id @default(uuid())
  userId       String?
  consentType  String
  policyVersion String
  accepted     Boolean
  source       String
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model DataDeletionRequest {
  id         String   @id @default(uuid())
  userId     String?
  email      String
  reason     String?
  status     String   @default("REQUESTED")
  createdAt  DateTime @default(now())
  resolvedAt DateTime?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ContactSubmission {
  id        String   @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  source    String   @default("website")
  status    String   @default("NEW")
  consent   Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomTripRequest {
  id            String   @id @default(uuid())
  userId        String?
  name          String
  email         String
  phone         String
  destination   String
  travelStart   DateTime?
  travelEnd     DateTime?
  travelers     Int
  pickupCity    String
  accommodation String?
  interests     String?
  budget        String?
  notes         String?
  status        String   @default("NEW")
  consent       Boolean
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ProviderRegistration {
  id              String   @id @default(uuid())
  userId          String?
  businessName    String
  ownerName       String
  email           String
  phone           String
  serviceCategory ServiceType
  location        String
  address         String?
  capacity        Int?
  description     String?
  status          String   @default("NEW")
  consent         Boolean
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SupportTicket {
  id          String           @id @default(uuid())
  userId      String?
  bookingId   String?
  guestEmail  String?
  subject     String
  issueType   String
  priority    String           @default("NORMAL")
  status      String           @default("OPEN")
  assignedTo  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages    SupportMessage[]
}

model SupportMessage {
  id         String        @id @default(uuid())
  ticketId   String
  authorId   String?
  body       String
  audience   String        @default("TRAVELER")
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model Payment {
  id                   String        @id @default(uuid())
  bookingId            String
  submittedById        String?
  amount               Int
  currency             String        @default("PKR")
  method               String
  transactionReference String?
  proofUrl             String?
  status               PaymentStatus @default(PENDING)
  reviewNote           String?
  reviewedById         String?
  submittedAt          DateTime      @default(now())
  reviewedAt           DateTime?
  booking              Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  submittedBy          User?         @relation("PaymentSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy           User?         @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
}

model Commission {
  id               String        @id @default(uuid())
  bookingId        String
  bookingItemId    String?
  providerId       String
  rate             Decimal       @db.Decimal(5, 2)
  grossAmount      Int
  commissionAmount Int
  providerAmount   Int
  currency         String        @default("PKR")
  createdAt        DateTime      @default(now())
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem      BookingItem?  @relation(fields: [bookingItemId], references: [id], onDelete: SetNull)
  provider         Provider      @relation(fields: [providerId], references: [id])
  payout           Payout?
}

model Payout {
  id           String       @id @default(uuid())
  providerId   String
  commissionId String       @unique
  amount       Int
  currency     String       @default("PKR")
  method       String?
  accountLabel String?
  status       PayoutStatus @default(PENDING)
  financeNote  String?
  approvedById String?
  paidAt       DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  provider     Provider     @relation(fields: [providerId], references: [id])
  commission   Commission   @relation(fields: [commissionId], references: [id])
  approvedBy   User?        @relation("PayoutApprover", fields: [approvedById], references: [id], onDelete: SetNull)
}
